[Unit]
Description=Game Factory: подтянуть образы и выложить
Documentation=https://github.com/sirrorist/game-factory/blob/main/docs/OPERATIONS.md
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/gf-update
TimeoutStartSec=15min
