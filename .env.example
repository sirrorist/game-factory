# Скопируй в .env и поправь под себя. Секретов здесь нет и быть не должно.

# Базовый домен для игр: игра открывается на <id>.<GF_PLAY_BASE_HOST>
GF_PLAY_BASE_HOST=play.localhost
GF_PLAY_PORT=4100
# Внешний адрес игр, как его видит браузер (схема и порт включительно).
# Читает хаб (этап 0б), сервер игр его не использует.
GF_PLAY_PUBLIC_ORIGIN_TEMPLATE=http://{id}.play.localhost:4100
# Кто имеет право встраивать игры в iframe (CSP frame-ancestors), через пробел
GF_HUB_ORIGINS=http://localhost:3000 http://hub.localhost:3000
# Где лежат собранные игры, реестр и архивы
GF_DATA_DIR=.data
