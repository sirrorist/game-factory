{
  "name": "game-factory",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "gf": "node tools/gf.ts",
    "shots": "node tests/shots.ts",
    "games:build": "node tools/gf.ts build",
    "games:export": "node tools/gf.ts export",
    "play": "node --env-file-if-exists=.env apps/play-server/src/main.ts",
    "hub": "pnpm --filter @gf/hub dev",
    "hub:build": "pnpm --filter @gf/hub build",
    "hub:start": "pnpm --filter @gf/hub start",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/game-sdk/tsconfig.json && pnpm -r --if-present run typecheck",
    "test": "node --test \"packages/**/*.test.ts\" \"apps/**/*.test.ts\" \"tools/**/*.test.ts\" \"games/*/test/*.test.ts\" \"tests/ui/*.test.ts\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/**/*.test.ts\"",
    "check": "pnpm typecheck && pnpm test && pnpm test:db && pnpm games:build && pnpm games:export && pnpm hub:build && pnpm test:e2e",
    "test:db": "node --test --test-concurrency=1 \"packages/db/test/*.pgtest.ts\"",
    "ui:list": "node tests/ui/cli.ts list",
    "ui:baseline": "node tests/ui/cli.ts baseline",
    "ui:preview": "node tests/ui/cli.ts preview",
    "ui:compare": "node tests/ui/cli.ts compare",
    "ui:check": "node tests/ui/cli.ts check",
    "ui:live": "node tests/ui/cli.ts live",
    "ui:verify": "node tests/ui/cli.ts verify",
    "ui:boundary": "node tests/ui/cli.ts boundary",
    "ui:wallet-review": "node tests/ui/cli.ts wallet-review",
    "ui:acceptance": "node tests/ui/cli.ts acceptance",
    "ui:typecheck": "tsc -p tests/ui/tsconfig.json",
    "ui:test": "node --test tests/ui/*.test.ts",
    "ui:regression": "node --test tests/ui/check-failures.browser.ts",
    "ui:smoke": "node tests/ui/browser-smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "playwright": "1.63.0",
    "typescript": "^7.0.2"
  }
}
